% Farben aus der FAU-Vorlage
\definecolor{faublau}{cmyk}{1,0.7,0,0.45}
\definecolor{fautech}{HTML}{8C9FB1}

\newcommand{\ffl@wortmarke}{\posterpath fau/fau-wortmarke.pdf}
\newcommand{\ffl@fablablogo}{\posterpath ../../logo/Logo/Logo-FAU-bunt.pdf}

% Inhalt des Posters
\newcommand{\postertitel}[1]{\def\ffl@titel{#1}}
\newcommand{\posteruntertitel}[1]{\def\ffl@untertitel{#1}}
\newcommand{\posterzusatz}[1]{\def\ffl@zusatz{#1}}
\newcommand{\posterfuss}[1]{\def\ffl@fuss{#1}}
\newcommand{\bildnachweis}[1]{\def\ffl@nachweis{#1}}
\newcommand{\absender}[2]{\def\ffl@uni{#1}\def\ffl@fakultaet{#2}}
\postertitel{}
\newsavebox{\ffl@titelbox}
\posteruntertitel{}
\posterzusatz{}
\posterfuss{fablab.fau.de}
\bildnachweis{}
\absender{Friedrich-Alexander-Universität}{Technische Fakultät}

% Schriftstufen
\newcommand{\titelschrift}{\fontsize{150}{170}\selectfont\bfseries}
\newcommand{\untertitelschrift}{\fontsize{64}{76}\selectfont}
\newcommand{\ueberschriftschrift}{\fontsize{64}{76}\selectfont\bfseries}
\newcommand{\textschrift}{\fontsize{44}{58}\selectfont}
\newcommand{\beschriftungschrift}{\fontsize{36}{44}\selectfont}
\newcommand{\nachweisschrift}{\fontsize{24}{30}\selectfont}

% Flattersatz mit genug Spielraum, damit bei großer Schrift keine Zeile
% über den Rand läuft
\setlength{\RaggedRightRightskip}{0pt plus 6em}
\AtBeginDocument{%
  \textschrift\RaggedRight
  % Titel immer einzeilig, zu lange Titel auf Satzbreite verkleinert
  \sbox{\ffl@titelbox}{\color{faublau}\titelschrift\ffl@titel}%
  \ifdim\wd\ffl@titelbox>\linewidth
    \resizebox{\linewidth}{!}{\usebox{\ffl@titelbox}}%
  \else
    \usebox{\ffl@titelbox}%
  \fi
  \par
  \ifx\ffl@untertitel\@empty\else
    \vspace{8mm}{\color{faublau}\untertitelschrift\ffl@untertitel\par}%
  \fi
  \ifx\ffl@zusatz\@empty\else
    \vspace{8mm}{\color{fautech}\beschriftungschrift\ffl@zusatz\par}%
  \fi
  \vspace{25.47mm}%
}

% Aufzählungen: Nummern in FAU-Blau
\setlist[enumerate]{label=\textcolor{faublau}{\bfseries\arabic*.},
  leftmargin=*,labelsep=6mm,topsep=8mm,itemsep=6mm,parsep=0pt}
% Aufzählungen ohne Nummer: Punkt in FAU-Blau
\setlist[itemize]{label=\textcolor{faublau}{\textbullet},
  leftmargin=*,labelsep=6mm,topsep=4mm,itemsep=2mm,parsep=0pt}

