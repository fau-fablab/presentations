% Maße in mm von unten links. Wortmarke ohne Schutzzone: links 77,03,
% oben 1138,22, Breite 131,67, F-Höhe 48,42 (Grundlinie 1089,81),
% rechts 208,70. X = 12,74.
\AddToShipoutPictureBG{%
  \put(0,0){%
  \begin{tikzpicture}[x=1mm,y=1mm]
    \useasboundingbox (0,0) rectangle (841,1189);
    \fill[white] (0,0) rectangle (841,1189);
    % FAU-Wortmarke, auf die Buchstaben zugeschnitten
    \node[anchor=north west,inner sep=0] at (77.03,1138.22)
      {\includegraphics[width=131.67mm,
        viewport=48.708 41.562 552.352 233.856,clip]{\ffl@wortmarke}};
    % Verbindungsstrich: X nach der Wortmarke, halbe Strichstärke
    \fill[faublau] (221.43-0.63,1089.81) rectangle (221.43+0.63,1138.22);
    % FabLab-Logo: 2X nach der Wortmarke, so hoch wie das F
    \node[anchor=west,inner sep=0] at (234.17,1114.01)
      {\includegraphics[height=49.45mm,
        viewport=29.241 8.982 514.298 96.012,clip]{\ffl@fablablogo}};
    % Feine Linie über dem Fuß
    \draw[faublau,line width=0.5mm] (77.03,108) -- (790.06,108);
    % Fuß auf zwei gemeinsamen Grundlinien: links Webadresse und
    % Bildnachweis, rechts der Absender wie in der FAU-Vorlage
    \node[anchor=base west,inner sep=0,text=faublau]
      at (77.03,80) {\beschriftungschrift\ffl@fuss};
    \node[anchor=base west,inner sep=0,text=fautech]
      at (77.03,64.5) {\nachweisschrift\ffl@nachweis};
    \node[anchor=base east,inner sep=0,text=faublau]
      at (790.06,80) {\beschriftungschrift\bfseries\ffl@uni};
    \node[anchor=base east,inner sep=0,text=fautech]
      at (790.06,64.5) {\beschriftungschrift\ffl@fakultaet};
  \end{tikzpicture}}%
}
%%%%%%%%%%%%%%%%%%%%%%%%%%%% Logozeile und Fuß Ende %%%%%%%%%%%%%%%%%%%%%%%%%%%%

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% Elemente %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Foto über die volle Satzbreite: \foto[Verschiebung nach oben]{Höhe in mm}{Datei}
% Das Foto wird auf Satzbreite skaliert und mittig beschnitten, die
% Verschiebung (in mm) wählt einen höheren Bildausschnitt.
\newcommand{\foto}[3][0]{%
  \par\noindent
  \begin{tikzpicture}
    \clip (0,0) rectangle (\linewidth,#2mm);
    \node[inner sep=0] at (0.5\linewidth,#2mm/2-#1mm)
      {\includegraphics[width=\linewidth]{#3}};
  \end{tikzpicture}\par
  \vspace{25.47mm}%
}

% Bild mit Beschriftung für Bildreihen:
% \bild[Verschiebung nach oben]{Breite}{Höhe}{Datei}{Beschriftung}
% Das Bild füllt das Feld und wird mittig beschnitten.
\newsavebox{\ffl@bildbox}
\newcommand{\bild}[5][0mm]{%
  \begin{minipage}[t]{#2}%
    \sbox{\ffl@bildbox}{\includegraphics[width=#2]{#4}}%
    \ifdim\ht\ffl@bildbox<#3\relax
      \sbox{\ffl@bildbox}{\includegraphics[height=#3]{#4}}%
    \fi
    \begin{tikzpicture}
      \clip (0,0) rectangle (#2,#3);
      \node[inner sep=0] at (#2/2,#3/2-#1) {\usebox{\ffl@bildbox}};
    \end{tikzpicture}%
    \ifx\relax#5\relax\else
      \par\vspace{4mm}%
      {\color{faublau}\beschriftungschrift\bfseries\RaggedRight #5\par}%
    \fi
  \end{minipage}%
}

% Zwei Spalten nach dem Raster: \spalten{links}{rechts}
\newcommand{\spalten}[2]{%
  \par\noindent
  \begin{minipage}[t]{343.78mm}\RaggedRight #1\end{minipage}%
  \hspace{25.47mm}%
  \begin{minipage}[t]{343.78mm}\RaggedRight #2\end{minipage}\par
}

% Drei Spalten nach dem Raster: \dreispalten{links}{mitte}{rechts}
\newcommand{\dreispalten}[3]{%
  \par\noindent
  \begin{minipage}[t]{220.70mm}\RaggedRight #1\end{minipage}%
  \hspace{25.47mm}%
  \begin{minipage}[t]{220.70mm}\RaggedRight #2\end{minipage}%
  \hspace{25.47mm}%
  \begin{minipage}[t]{220.70mm}\RaggedRight #3\end{minipage}\par
}

% Text über zwei von drei Spalten, z.B. für Einleitungen: \zweidrittel{Text}
\newcommand{\zweidrittel}[1]{%
  \par\noindent
  \begin{minipage}[t]{467.03mm}\RaggedRight #1\end{minipage}\par
}

% Abstand zwischen Blöcken: G
\newcommand{\blockabstand}{\par\vspace{25.47mm}}

% Stichwort im Text, z.B. als Zwischenüberschrift
\newcommand{\stichwort}[1]{{\color{faublau}\bfseries #1}}

% Überschrift eines Abschnitts
\newcommand{\abschnitt}[1]{%
  \par{\color{faublau}\ueberschriftschrift
    \hyphenpenalty=10000\exhyphenpenalty=10000 #1\par}\vspace{6mm}%
}

% QR-Code mit Beschriftung: \qrfeld[Kantenlänge]{URL}{Beschriftung}
\newcommand{\qrfeld}[3][120mm]{%
  \begin{tabular}[t]{@{}c@{}}
    \qrcode[height=#1]{#2}\\[10mm]
    {\color{faublau}\beschriftungschrift\bfseries #3}
  \end{tabular}%
}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% Elemente Ende %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\makeatother
